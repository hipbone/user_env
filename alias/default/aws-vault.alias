# aws-vault 단축 alias
#
# 전제: aws-vault 설치 + ~/.aws/config 프로필 정의
#       백엔드(--backend=file)는 zshrc 의 AWS_VAULT_BACKEND 로 지정되므로 여기서 안 붙인다.
#
# 셸 전체를 한 프로필로 전환하려면 alias 가 아니라 ~/functions/aws.zsh 의 av-on 을 쓴다.
# 여기 alias 는 "한 번만 실행" 용도.
#
# command -v 가드를 걸지 않는다. alias 파일은 brew shellenv 보다 먼저 로드되므로
# 이 시점엔 aws-vault(brew 설치)가 아직 PATH에 없다. alias 정의 자체는 에러를 내지 않는다.

# 단발 실행: avx hive-live -- aws s3 ls
alias avx='aws-vault exec'

# 키스토어에 등록된 자격증명 목록
alias av-list='aws-vault list'

# 지금 자격증명이 어느 계정/사용자인지
alias av-who='aws sts get-caller-identity'
