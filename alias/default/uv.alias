# uv - Python 패키지·프로젝트·버전 관리자
# 전제: uv 가 PATH에 있어야 함 (bash setEnv.sh -e uv)
#
# uv 는 pip / venv / pyenv / pipx 역할을 한 번에 한다.
# 프로젝트 안에서는 uv run 을 쓰면 .venv 활성화 없이도 동작한다.

if command -v uv &> /dev/null; then
  # --- 프로젝트 ---
  alias uvi='uv init'                 # 새 프로젝트 생성
  alias uvs='uv sync'                 # pyproject.toml/uv.lock 기준으로 환경 동기화
  alias uvr='uv run'                  # 프로젝트 환경에서 실행 (활성화 불필요)
  alias uvl='uv lock'                 # 잠금 파일 갱신
  alias uvtree='uv tree'              # 의존성 트리

  # --- 의존성 ---
  alias uva='uv add'                  # 예: uva requests
  alias uvad='uv add --dev'           # 개발 의존성
  alias uvrm='uv remove'

  # --- Python 버전 ---
  alias uvpy='uv python list'         # 설치된/설치 가능한 Python
  alias uvpyi='uv python install'     # 예: uvpyi 3.12

  # --- 가상환경 ---
  alias uvv='uv venv'                 # .venv 생성

  # --- 도구 실행 ---
  # uvx <도구> : 설치 없이 일회성 실행 (예: uvx ruff check)
  alias uvt='uv tool install'         # 전역 CLI 도구 설치
  alias uvtl='uv tool list'
fi
