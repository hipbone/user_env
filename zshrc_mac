# ~/.zshrc (macOS)
#
# 이 파일은 user_env 저장소의 zshrc_mac 에 대한 심볼릭 링크다.
# 홈의 ~/.zshrc 를 직접 고치지 말고 저장소 원본을 고칠 것.
#
# zshrc_ubuntu 와 같은 구조를 유지한다. 한쪽만 고치지 말 것.

# ---------------------------------------------------------------- #
# powerlevel10k instant prompt
# 콘솔 입력이 필요한 초기화 코드는 반드시 이 블록 위에 둘 것
# ---------------------------------------------------------------- #
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ---------------------------------------------------------------- #
# oh-my-zsh
# ---------------------------------------------------------------- #
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
DEFAULT_USER=$(whoami)

plugins=(
    git
    zsh-syntax-highlighting
    zsh-autosuggestions
)

source $ZSH/oh-my-zsh.sh

# 프롬프트 설정 (config/p10k.zsh 의 심볼릭 링크)
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# ---------------------------------------------------------------- #
# 사용자 환경변수 — 저장소 밖(git 미관리). 토큰·키는 전부 여기에.
# ---------------------------------------------------------------- #
test -f "${HOME}/.env_vars" && source "${HOME}/.env_vars"

# ---------------------------------------------------------------- #
# alias / functions — ~/alias, ~/functions 는 저장소를 가리키는 링크
# macOS에서는 alias/ubuntu 를 로드하지 않는다.
# ---------------------------------------------------------------- #
for dir in "${HOME}/alias/default" "${HOME}/functions"; do
    if [ -d "${dir}" ]; then
        for file in "${dir}"/*(.N); do
            source "${file}"
        done
    fi
done
unset dir file

# ---------------------------------------------------------------- #
# 표시 설정
# ---------------------------------------------------------------- #
test $(which bat) && alias cat="bat"

export CLICOLOR=1
LSCOLORS=Gxfxcxdxbxegedabagacad

# ---------------------------------------------------------------- #
# PATH
# ---------------------------------------------------------------- #
# uv / uv tool 설치 도구 (uv, uvx, tccli 등)
[[ -d "$HOME/.local/bin" ]] && export PATH="$HOME/.local/bin:$PATH"

# ---------------------------------------------------------------- #
# 자동완성
# ---------------------------------------------------------------- #
fpath+=~/.zfunc
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select

# tccli — zsh용 완성 스크립트가 없고 bash 형식 completer만 제공하므로 bashcompinit로 연결
if command -v tccli_completer &>/dev/null; then
  autoload -Uz bashcompinit && bashcompinit
  complete -C tccli_completer tccli
fi
