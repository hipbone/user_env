# ~/.zshrc (Ubuntu / WSL)
#
# 이 파일은 user_env 저장소의 zshrc_ubuntu 에 대한 심볼릭 링크다.
# 홈의 ~/.zshrc 를 직접 고치지 말고 저장소 원본을 고칠 것.
#
# 원칙: 도구가 설치되지 않은 장비에서도 에러 없이 로드되어야 한다.
#       모든 외부 도구 연동은 반드시 존재 확인 후 실행한다.

# ---------------------------------------------------------------- #
# powerlevel10k instant prompt
# 콘솔 입력이 필요한 초기화 코드는 반드시 이 블록 위에 둘 것
# ---------------------------------------------------------------- #
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ---------------------------------------------------------------- #
# oh-my-zsh
# ---------------------------------------------------------------- #
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
DEFAULT_USER=$(whoami)

plugins=(
    git
    zsh-syntax-highlighting
    zsh-autosuggestions
)

source $ZSH/oh-my-zsh.sh

# 프롬프트 설정 (config/p10k.zsh 의 심볼릭 링크)
# 프롬프트를 바꿨다면 `p10k configure` 후 저장소에 반영: bash setEnv.sh -e dotfiles
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# ---------------------------------------------------------------- #
# 사용자 환경변수 — 저장소 밖(git 미관리). 토큰·키는 전부 여기에.
# ---------------------------------------------------------------- #
test -f "${HOME}/.env_vars" && source "${HOME}/.env_vars"

# ---------------------------------------------------------------- #
# alias / functions — ~/alias, ~/functions 는 저장소를 가리키는 링크
# ---------------------------------------------------------------- #
for dir in "${HOME}/alias/default" "${HOME}/alias/ubuntu" "${HOME}/functions"; do
    if [ -d "${dir}" ]; then
        for file in "${dir}"/*(.N); do
            source "${file}"
        done
    fi
done
unset dir file

# 머신 로컬 alias — 저장소 밖(git 미관리). 사내 IP·계정 등은 여기에.
test -f /etc/zsh/alias.sh && source /etc/zsh/alias.sh

# ---------------------------------------------------------------- #
# 로케일
# ---------------------------------------------------------------- #
export LANG=ko_KR.UTF-8

# ---------------------------------------------------------------- #
# 개발 도구 — 설치된 것만 조건부로 로드
# ---------------------------------------------------------------- #
# homebrew
test -d ~/.linuxbrew && eval "$(~/.linuxbrew/bin/brew shellenv)"
test -d /home/linuxbrew/.linuxbrew && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "/home/linuxbrew/.linuxbrew/opt/nvm/nvm.sh" ] && \. "/home/linuxbrew/.linuxbrew/opt/nvm/nvm.sh"
[ -s "/home/linuxbrew/.linuxbrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/home/linuxbrew/.linuxbrew/opt/nvm/etc/bash_completion.d/nvm"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# rbenv
if command -v rbenv &>/dev/null; then
  eval "$(rbenv init -)"
fi

# direnv
if command -v direnv &>/dev/null; then
  eval "$(direnv hook zsh)"
fi

# ---------------------------------------------------------------- #
# PATH
# ---------------------------------------------------------------- #
# uv / uv tool 설치 도구 (uv, uvx, tccli 등)
[[ -d "$HOME/.local/bin" ]] && export PATH="$HOME/.local/bin:$PATH"

# Go
[[ -d "/usr/local/go/bin" ]] && export PATH="$PATH:/usr/local/go/bin"
[[ -d "$HOME/go/bin" ]] && export PATH="$PATH:$HOME/go/bin"

# ---------------------------------------------------------------- #
# 자동완성
# ---------------------------------------------------------------- #
fpath+=~/.zfunc
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select

# tccli — zsh용 완성 스크립트가 없고 bash 형식 completer만 제공하므로 bashcompinit로 연결
if command -v tccli_completer &>/dev/null; then
  autoload -Uz bashcompinit && bashcompinit
  complete -C tccli_completer tccli
fi
