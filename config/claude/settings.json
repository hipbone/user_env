{
  "model": "opus",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "theme": "dark-daltonized",
  "editorMode": "vim",
  "agentPushNotifEnabled": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Read(~/.env_vars)",
      "Read(//etc/zsh/alias.sh)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.tccli/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.backup)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  }
}
